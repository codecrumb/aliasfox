# Copy to .env and fill in. Never commit .env.

# REQUIRED, no default, at least 32 characters (shorter refuses startup).
# Encrypts the stored Apple session (AES-256-GCM).
# Generate one:  python -m aliasfox gen-secret
# Changing it makes stored sessions unreadable and invalidates login cookies.
ALIASFOX_SECRET_KEY=

# Require a password to use AliasFox. Required when exposed beyond this machine.
AUTH_ENABLED=false
# Argon2id hash of the password (needed when AUTH_ENABLED=true).
# Generate one:  python -m aliasfox hash-password
# KEEP THE SINGLE QUOTES: the hash contains `$`, which .env/compose interpolate.
# An unparsable hash refuses startup.
ALIASFOX_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'

# Optional Postgres (postgres:// and postgresql:// are accepted). If unset, SQLite
# is used at DATA_DIR/aliasfox.db. Required on hosts without a persistent disk.
DATABASE_URL=
# DATA_DIR=/data   (set by the Docker image; defaults to /data otherwise)

# LOCAL TESTING ONLY. A full iCloud web session cookie seeding the stored session.
# Do not set this on a deployed or shared instance.
ICLOUD_COOKIE=

# Set true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUSTED_PROXY=false
# Number of trusted proxies in front of the app: the client IP is the Nth entry
# from the right of X-Forwarded-For. Verify it on first deploy (see README).
# TRUSTED_PROXY_HOPS=1

# Lets a container bind 0.0.0.0 with auth off. Only with a loopback-only published
# port (the compose file sets it). Never set on a public deployment.
# ALIASFOX_ALLOW_UNAUTHENTICATED_NETWORK=false

# Bind address. Non-loopback addresses need AUTH_ENABLED=true (the compose file
# sets ALIASFOX_ALLOW_UNAUTHENTICATED_NETWORK for its loopback-only publish).
# Leave unset under Docker (the image sets HOST=0.0.0.0, PORT=8080).
# HOST=127.0.0.1
# PORT=8080

# single (one owner) or multi (many users signing in through Neon Auth).
# In multi, AUTH_ENABLED and ALIASFOX_PASSWORD_HASH are ignored, and startup
# requires NEON_AUTH_BASE_URL, NEON_AUTH_JWKS_URL, DATABASE_URL, TRUSTED_PROXY=true,
# CONTACT_EMAIL and a single worker (WEB_CONCURRENCY unset or 1).
# ALIASFOX_MODE=single

# --- multi mode only ---
# Neon Auth base URL and the JWKS URL used to verify its tokens.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=
# Expected token issuer (`iss`). Defaults to scheme://host of NEON_AUTH_BASE_URL;
# set it only if Neon Auth's tokens carry a different issuer.
# NEON_AUTH_ISSUER=
# Per-user API keys (default true; false hides and disables them).
# API_KEYS_ENABLED=true
# Allow new users to sign up (default false: existing users only).
# SIGNUPS_ENABLED=false
# Comma-separated emails always allowed to sign up, case-insensitive.
# SIGNUP_ALLOWLIST=
# Comma-separated Neon Auth user ids (token `sub`) refused at sign-in with
# account_disabled (suspended users). Restart to apply. See README.
# SUBJECT_DENYLIST=
# Public origin of this deployment (recommended). Must be https (http only for localhost).
# PUBLIC_URL=
# REQUIRED in multi mode: one plain contact address shown on the privacy and terms pages.
# CONTACT_EMAIL=
