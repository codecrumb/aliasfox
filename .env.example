# Copy to .env and fill in. Never commit .env.

# REQUIRED, no default. Encrypts the stored Apple session (AES-256-GCM).
# Generate one:  python -m aliasfox gen-secret
# Changing it makes stored sessions unreadable and invalidates login cookies.
ALIASFOX_SECRET_KEY=

# Require a password to use AliasFox. Required when exposed beyond this machine.
AUTH_ENABLED=false
# Argon2id hash of the password (needed when AUTH_ENABLED=true).
# Generate one:  python -m aliasfox hash-password
ALIASFOX_PASSWORD_HASH=

# Optional Postgres (postgres:// and postgresql:// are accepted). If unset, SQLite
# is used at DATA_DIR/aliasfox.db. Required on hosts without a persistent disk.
DATABASE_URL=
# DATA_DIR=/data   (set by the Docker image; defaults to /data otherwise)

# LOCAL TESTING ONLY. A full iCloud web session cookie seeding the stored session.
# Do not set this on a deployed or shared instance.
ICLOUD_COOKIE=

# Set true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUSTED_PROXY=false

# Bind address. Non-loopback addresses need AUTH_ENABLED=true (the compose file
# sets ALIASFOX_ALLOW_UNAUTHENTICATED_NETWORK for its loopback-only publish).
# Leave unset under Docker (the image sets HOST=0.0.0.0, PORT=8080).
# HOST=127.0.0.1
# PORT=8080

# single (one owner) or multi
# ALIASFOX_MODE=single
